generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

model User {
  id           String         @id @default(cuid())
  firstName    String
  lastName     String
  email        String         @unique
  phone        String?
  country      String?
  role         Role           @default(CUSTOMER)
  passwordHash String
  createdAt    DateTime       @default(now())
  bookings     Booking[]
  notifications Notification[]
}

model Vehicle {
  id            String   @id
  brand         String
  model         String
  category      String
  pricePerDay   Int
  availability  String
  createdAt     DateTime @default(now())
  bookings      Booking[]
}

model Booking {
  id              String        @id
  vehicleId       String?
  vehicleName     String
  pickupLocation  String
  dropoffLocation String
  pickupDate      String
  returnDate      String
  pickupTime      String?
  returnTime      String?
  amount          Int
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  customerId      String?
  customer        User?         @relation(fields: [customerId], references: [id])
  vehicle         Vehicle?      @relation(fields: [vehicleId], references: [id])
  payments        Payment[]
  invoices        Invoice[]
  createdAt       DateTime      @default(now())
}

model Payment {
  id        String        @id
  bookingId String?
  booking   Booking?      @relation(fields: [bookingId], references: [id])
  method    String
  amount    Int
  status    PaymentStatus
  paidOn    String?
  createdAt DateTime      @default(now())
}

model Invoice {
  id        String        @id
  bookingId String?
  booking   Booking?      @relation(fields: [bookingId], references: [id])
  amount    Int
  status    PaymentStatus
  issuedOn  String?
  createdAt DateTime      @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  category  String
  title     String
  message   String
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  vehicleName String
  note        String
  status      String
  createdAt   DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Int
  category    String
  spentOn     String?
  createdAt   DateTime @default(now())
}
